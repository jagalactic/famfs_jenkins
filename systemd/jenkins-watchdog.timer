[Unit]
Description=Daily Jenkins CI watchdog
# Pairs with jenkins-watchdog.service.

[Timer]
# 09:00: the nightly jobs (01:00-04:00 starts) have had time to run.
OnCalendar=*-*-* 09:00:00
RandomizedDelaySec=300
# Catch up once on boot if a run was missed.
Persistent=true

[Install]
WantedBy=timers.target
