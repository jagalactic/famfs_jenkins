[Unit]
# Poll the public kernel repo, Miklos' fuse tree and the famfs repo, pick the
# phase (premerge: Miklos' fuse-update-7.4 tag / master: mainline after the
# merge / tags: v7.4+ release, rc and stable tags), and dispatch the
# famfs_regression_public Jenkins job. Idempotent: dedup state lives in
# ~jmg/.famfs-regression-watch; the first run baselines the tag lists (no tag
# flood) but still sends the nightly tip build, so it is safe to run on a
# timer. Paired with famfs-regression-watch.timer; not enabled directly.
Description=Watch kernel/famfs repos and dispatch famfs_regression_public
After=network-online.target
Wants=network-online.target
OnFailure=status-email@%n.service

[Service]
Type=oneshot
User=jmg
WorkingDirectory=/home/jmg/w/famfs_jenkins
# Reads the Jenkins API token from ./api-key.md and POSTs buildWithParameters to
# http://jenkins-server:8080. Policy (repos, KERNEL_MIN, the pre-merge ref,
# FAMFS_MIN/FAMFS_KEEP, WATCH_* toggles) lives in the script's config block;
# override here with Environment= lines if needed, e.g.:
#   Environment=FAMFS_MIN=1.0
#   Environment=PREMERGE_REF=for-next
ExecStart=/home/jmg/w/famfs_jenkins/scripts/famfs-regression-watch.sh
# ls-remote + one small fetch into the mirror + a curl POST; allow for slow mirrors.
TimeoutStartSec=600

# The timer schedules this; no [Install] here (the .timer is what gets enabled).
