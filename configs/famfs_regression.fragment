# famfs_regression.fragment
#
# CONFIG_* that famfs_regression_public needs on an ARBITRARY public kernel,
# merged by run_qemu_fixture's config-fragment path onto the run_qemu base
# config (configs/famfs_qemu_ndctl.config). The base carries the run_qemu
# boot/rootfs bits; this fragment forces the pieces the famfs fuse smoke needs
# back on in case `make olddefconfig` for a different kernel drops them:
#
#   - nfit_test-backed pmem + device-dax (the 6G devdax the smoke runs on)
#   - FUSE, with the extent-map / backing-file support that carries the famfs
#     enablement in Miklos' tree (fs/fuse/ext_map.o + backing.o are built
#     under CONFIG_FUSE_PASSTHROUGH as of the fuse-update-7.4 pull request)
#
# No cxl (the famfs smoke does not use cxl_test) and no fs/famfs v1 module:
# public kernels only have famfs in fuse mode, so the autorun runs --fuse +
# the unit tests and skips --nofuse by design.
#
# The famfs-fork-only symbols at the bottom are harmless on a public kernel:
# olddefconfig drops an unknown symbol silently. run_qemu_fixture asserts the
# critical subset (assertConfig in famfs_regression_public.groovy) so a dropped
# required symbol fails the build loudly instead of silently mis-testing.

# --- memory / zone-device (backing for pmem/dax) ---
CONFIG_ZONE_DEVICE=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_TRANSPARENT_HUGEPAGE=y

# --- libnvdimm / nfit (nfit_test backend) ---
CONFIG_LIBNVDIMM=m
CONFIG_BLK_DEV_PMEM=m
CONFIG_ND_BTT=m
CONFIG_ND_PFN=m
CONFIG_ND_CLAIM=y
CONFIG_NVDIMM_PFN=y
CONFIG_NVDIMM_DAX=y
CONFIG_ACPI_NFIT=m
CONFIG_X86_PMEM_LEGACY=m

# --- device-dax / fs-dax ---
CONFIG_DAX=y
CONFIG_DEV_DAX=m
CONFIG_DEV_DAX_PMEM=m
CONFIG_DEV_DAX_KMEM=m
CONFIG_DEV_DAX_HMEM=m
CONFIG_DEV_DAX_HMEM_DEVICES=y
CONFIG_FS_DAX=y

# --- fuse (famfs fuse mode) ---
CONFIG_FUSE_FS=m
CONFIG_FUSE_PASSTHROUGH=y
CONFIG_FUSE_IO_URING=y
# famfs-fork kernels only (dropped by olddefconfig elsewhere)
CONFIG_FUSE_DAX=y
CONFIG_FUSE_FAMFS_DAX=y
